// Sonoranroots Inventory — v1 data model
// See ANALYSIS.md (Downloads/consumables) for the full rationale behind this design;
// it replaces the Google-Sheets/IMPORTRANGE system documented there.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organizational structure
// ---------------------------------------------------------------------------

model Book {
  id    String @id @default(cuid())
  name  String @unique // Retail, Cultivation, Manufacturing, Joint Venture/Admin
  code  String @unique // short code, e.g. RTL, CUL, MFG, JVA
  sites Site[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id        String   @id @default(cuid())
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    String
  name      String
  code      String   @unique
  isStaging Boolean  @default(false) // e.g. "The Highway" intake/staging tabs
  isActive  Boolean  @default(true) // replaces hiding retired-site tabs
  address   String?
  type      SiteType @default(FACILITY)

  employees       Employee[]
  transactions    InventoryTransaction[]
  transfersFrom   Transfer[]                @relation("TransferFromSite")
  transfersTo     Transfer[]                @relation("TransferToSite")
  checkoutEvents  CheckoutEvent[]
  audits          Audit[]
  purchaseOrders  PurchaseOrder[]
  reconciliations InventoryReconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

enum SiteType {
  FACILITY // a real physical site people work at
  STAGING // e.g. "The Highway" intake tabs
  VIRTUAL // e.g. an out-of-state sales channel like Alaska
}

model Employee {
  id        String    @id @default(cuid())
  name      String
  initials  String? // for mapping legacy "who did this" data
  site      Site?     @relation(fields: [siteId], references: [id])
  siteId    String?
  isActive  Boolean   @default(true)
  // Kiosk PIN, stored only as a keyed digest (HMAC, see src/lib/pin.ts).
  // The PIN IS the kiosk identity: the checkout screen has no name picker,
  // it looks the employee up by digest when the PIN is entered — which is
  // why it has to be globally unique (@unique), and why it's an HMAC rather
  // than a per-row salted hash (a salt would make the lookup a table scan).
  // Null = not set up yet (set at the kiosk via "Forgot your PIN?", or at
  // sign-up for app users). Self-serve by design: an admin can only clear
  // it from the employee edit page, never set/view its value.
  pinDigest String?   @unique
  // Kiosk-only authority: a MANAGER/ADMIN employee can approve clearing a
  // coworker's forgotten PIN right at the kiosk (their own PIN + this role
  // is the check — see approveKioskPinReset). Unrelated to User.role below,
  // which gates the desktop app instead; most employees have no User
  // account at all, so this has to live on Employee, not User.
  role      StaffRole @default(USER)
  // The Better Auth login (User below) behind this person, if any. An app
  // user and a kiosk user are the same person: signing up for the app creates
  // the Employee (and its PIN) in the same step, so every personal login has
  // one. Employees WITHOUT a login are kiosk-only people who self-registered
  // on a shared tablet; Users WITHOUT an Employee are those shared,
  // location-signed-in tablet accounts themselves. SetNull rather than
  // cascade: deleting someone's login shouldn't delete their employment
  // record, just their app access.
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?   @unique

  inventoryTransactions InventoryTransaction[]
  transfersRequested    Transfer[]                @relation("TransferRequestedBy")
  transfersReceived     Transfer[]                @relation("TransferReceivedBy")
  checkoutEvents        CheckoutEvent[]
  auditsPerformed       Audit[]
  reconciliationsClosed InventoryReconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Item master data
// ---------------------------------------------------------------------------

model Category {
  id         String     @id @default(cuid())
  name       String     @unique // the ~14 consolidated categories
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId   String?
  children   Category[] @relation("CategoryHierarchy")
  legacyCode String? // e.g. CM, PM, SRM

  items         Item[]
  legacyAliases LegacyCategoryAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Maps the 24 raw/legacy spreadsheet category names onto the consolidated
// taxonomy above, so historical data/imports don't require manual re-tagging.
model LegacyCategoryAlias {
  id              String   @id @default(cuid())
  rawCategoryName String   @unique
  category        Category @relation(fields: [categoryId], references: [id])
  categoryId      String
}

enum MaterialType {
  DM // Direct Material
  IM // Indirect Material
  PM // Packaging Material
  MM // Marketing Material
  AFS // Available for Sale / Finished Product
  NA // Not applicable
}

model UnitOfMeasure {
  id          String  @id @default(cuid())
  code        String  @unique // Unit, Bundle, Filter, Bag, Case, Box, Gallon, Roll...
  description String?

  items Item[]
}

model Vendor {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  items                 Item[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  vendorCredits         VendorCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id               String  @id @default(cuid())
  legacyId         String? @unique // old EEA2CAD### string, kept for migration reference
  sku              String? @unique
  name             String  @unique // canonical display name; real uniqueness enforced here (not free text everywhere)
  brand            String?
  genericName      String?
  variant          String? // Strain / Color / Model
  size             String? // Size / Weight / Dimensions
  specialAttribute String?

  category        Category      @relation(fields: [categoryId], references: [id])
  categoryId      String
  materialType    MaterialType  @default(NA)
  defaultUom      UnitOfMeasure @relation(fields: [defaultUomId], references: [id])
  defaultUomId    String
  defaultVendor   Vendor?       @relation(fields: [defaultVendorId], references: [id])
  defaultVendorId String?
  isActive        Boolean       @default(true)

  inventoryTransactions InventoryTransaction[]
  transferLines         TransferLine[]
  checkoutLines         CheckoutLine[]
  auditLines            AuditLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  reconciliationLines   ReconciliationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// The single inventory ledger — replaces the whole IMPORTRANGE chain
// (Master tabs, The Highway, Check Out Log, Discrepancy adjustments).
// Current on-hand per item/site = SUM(quantity) WHERE itemId=? AND siteId=?
// ---------------------------------------------------------------------------

enum TransactionType {
  OPENING_BALANCE // initial on-hand qty entered via CSV import at cutover, not a real business event
  PURCHASE
  SALE
  SALE_OUT_OF_STATE // legacy "Sale (AK)"
  PRODUCTION
  TRANSFER_OUT
  TRANSFER_IN
  DISCREPANCY
  CHECKOUT
  CHECKOUT_RETURN
  DAMAGED
}

model InventoryTransaction {
  id         String          @id @default(cuid())
  item       Item            @relation(fields: [itemId], references: [id])
  itemId     String
  type       TransactionType
  site       Site            @relation(fields: [siteId], references: [id])
  siteId     String
  quantity   Float // signed: positive = increases on-hand, negative = decreases
  unitCost   Float?
  totalValue Float? // denormalized qty * unitCost, kept in sync at write time

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?

  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  purchaseOrderLineId String?

  transfer   Transfer? @relation(fields: [transferId], references: [id])
  transferId String?

  checkoutEvent   CheckoutEvent? @relation(fields: [checkoutEventId], references: [id])
  checkoutEventId String?

  audit   Audit?  @relation(fields: [auditId], references: [id])
  auditId String?

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?

  occurredAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  createdBy  String? // free-text fallback until Entra ID auth is wired in

  @@index([itemId, siteId])
  @@index([siteId, occurredAt])
  @@index([transferId])
  @@index([checkoutEventId])
  @@index([purchaseOrderLineId])
}

// ---------------------------------------------------------------------------
// Transfers between sites — the workflow the spreadsheet system never had:
// a real header, a status, and native cross-book support.
// ---------------------------------------------------------------------------

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Transfer {
  id     String         @id @default(cuid())
  status TransferStatus @default(REQUESTED)

  fromSite   Site   @relation("TransferFromSite", fields: [fromSiteId], references: [id])
  fromSiteId String
  toSite     Site   @relation("TransferToSite", fields: [toSiteId], references: [id])
  toSiteId   String

  requestedBy   Employee? @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  requestedById String?
  receivedBy    Employee? @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  receivedById  String?

  requestedAt DateTime  @default(now())
  receivedAt  DateTime?
  notes       String?

  lines                 TransferLine[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([status])
}

model TransferLine {
  id         String   @id @default(cuid())
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Float
  unitCost   Float?

  @@index([transferId])
}

// ---------------------------------------------------------------------------
// Checkouts — replaces the central "Check Out Log" workbook. Every event is
// tied to a real employee and (optionally) a purpose, which the old system
// never captured.
// ---------------------------------------------------------------------------

model CheckoutEvent {
  id         String   @id @default(cuid())
  site       Site     @relation(fields: [siteId], references: [id])
  siteId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  occurredAt DateTime @default(now())
  department String?
  purpose    String?
  notes      String?
  isReturn   Boolean  @default(false)

  lines                 CheckoutLine[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())

  @@index([siteId, occurredAt])
}

model CheckoutLine {
  id              String        @id @default(cuid())
  checkoutEvent   CheckoutEvent @relation(fields: [checkoutEventId], references: [id], onDelete: Cascade)
  checkoutEventId String
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          String
  quantity        Float // unsigned; direction implied by CheckoutEvent.isReturn

  @@index([checkoutEventId])
}

// ---------------------------------------------------------------------------
// Audits — replaces "new tab every month per site". Finalizing a line with a
// nonzero variance generates a DISCREPANCY row in InventoryTransaction.
// ---------------------------------------------------------------------------

enum AuditStatus {
  IN_PROGRESS
  FINALIZED
  CANCELLED
}

model Audit {
  id            String      @id @default(cuid())
  site          Site        @relation(fields: [siteId], references: [id])
  siteId        String
  auditDate     DateTime
  performedBy   Employee?   @relation(fields: [performedById], references: [id])
  performedById String?
  status        AuditStatus @default(IN_PROGRESS)

  lines                 AuditLine[]
  inventoryTransactions InventoryTransaction[]
  reconciliations       InventoryReconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, auditDate])
}

model AuditLine {
  id               String  @id @default(cuid())
  audit            Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId          String
  item             Item    @relation(fields: [itemId], references: [id])
  itemId           String
  systemQtyAtAudit Float // snapshot of computed on-hand when the audit line was opened
  countedQty       Float?
  notes            String?

  @@index([auditId])
}

// ---------------------------------------------------------------------------
// Inventory reconciliation — a period close (calendar month-end for the
// legacy process, or a rolling 30-day window under the new parent company)
// that snapshots ending quantities/values/usage per item at a site, computed
// live from the ledger. A reconciliation must have a finalized Audit for
// the same site linked to it before it can be closed — the physical count
// happens in the existing Audit screens, and closing just verifies one is
// attached and finalized rather than re-implementing counting here. Closing
// freezes the numbers — later ledger corrections don't retroactively change
// a closed period's report, matching how the old company's month-end close
// worked.
// ---------------------------------------------------------------------------

enum ReconciliationStatus {
  OPEN
  CLOSED
  CANCELLED
}

model InventoryReconciliation {
  id          String               @id @default(cuid())
  site        Site                 @relation(fields: [siteId], references: [id])
  siteId      String
  periodStart DateTime
  periodEnd   DateTime
  status      ReconciliationStatus @default(OPEN)
  notes       String?

  audit   Audit?  @relation(fields: [auditId], references: [id])
  auditId String?

  closedAt   DateTime?
  closedBy   Employee? @relation(fields: [closedById], references: [id])
  closedById String?

  lines ReconciliationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, periodStart])
  @@index([auditId])
}

// One row per item touched at the site during (or carried into) the period.
// All quantity/value fields are computed from the ledger at refresh time and
// frozen as-is the moment the parent reconciliation is closed.
model ReconciliationLine {
  id               String                  @id @default(cuid())
  reconciliation   InventoryReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationId String
  item             Item                    @relation(fields: [itemId], references: [id])
  itemId           String

  beginningQty Float // on-hand as of periodStart
  endingQty    Float // on-hand as of periodEnd

  unitCost       Float? // most recent known cost for the item as of periodEnd, used to value endingQty and the fields below
  endingValue    Float? // endingQty * unitCost
  beginningValue Float? // beginningQty * unitCost

  purchasedQty     Float @default(0)
  purchasedValue   Float @default(0) // uses the transaction's own recorded cost, not unitCost
  producedQty      Float @default(0)
  producedValue    Float @default(0)
  transferInQty    Float @default(0)
  transferInValue  Float @default(0) // uses the transaction's own recorded cost, not unitCost
  transferOutQty   Float @default(0)
  transferOutValue Float @default(0) // uses the transaction's own recorded cost, not unitCost
  soldQty          Float @default(0)
  soldValue        Float @default(0)
  soldAkQty        Float @default(0)
  soldAkValue      Float @default(0)
  usedQty          Float @default(0) // checkouts (net of returns) + damaged + audit discrepancies, magnitude
  usedValue        Float @default(0)
  consumedQty      Float @default(0) // sold + soldAk + used combined, magnitude — the existing par-level/usage-report metric
  discrepancyQty   Float @default(0) // net audit variance posted during the period
  discrepancyValue Float @default(0)

  usageRatePerDay Float? // consumedQty / period length in days — feeds future par-level analytics

  @@index([reconciliationId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Purchasing — minimal v1 support, linked by PO number, replacing the
// separate Purchasing/EOM Prepaid Inventory Report & Credit Tracking workbook.
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
}

// A PO is invoice-shaped: a header plus real line items, received at a
// single site (possibly over several partial deliveries — see
// PurchaseOrderLine below for how partial receiving is tracked and how it
// auto-posts to the inventory ledger).
model PurchaseOrder {
  id         String              @id @default(cuid())
  site       Site                @relation(fields: [siteId], references: [id])
  siteId     String
  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  vendorId   String
  poNumber   String              @unique
  orderDate  DateTime
  status     PurchaseOrderStatus @default(OPEN)
  paidInFull Boolean             @default(false)
  notes      String?

  lines                 PurchaseOrderLine[]
  payments              PurchaseOrderPayment[]
  inventoryTransactions InventoryTransaction[]
  vendorCredits         VendorCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([vendorId])
}

// One row per item on the PO — the actual invoice line: what was ordered,
// how much, and at what cost. Quantity received to date for a line =
// SUM(InventoryTransaction.quantity) WHERE purchaseOrderLineId = this line's
// id; each delivery recorded against a line posts a real PURCHASE
// transaction at the PO's site, so receiving directly drives on-hand.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          String
  quantityOrdered Float
  unitCost        Float

  inventoryTransactions InventoryTransaction[]

  @@index([purchaseOrderId])
}

model PurchaseOrderPayment {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  paymentDate     DateTime
  amount          Float

  @@index([purchaseOrderId])
}

model VendorCredit {
  id                 String         @id @default(cuid())
  vendor             Vendor         @relation(fields: [vendorId], references: [id])
  vendorId           String
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId    String?
  creditDate         DateTime
  amount             Float
  accountingNotified Boolean        @default(false)
  notes              String?

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Auth (Better Auth) — interim app-wide login until the Entra ID migration.
// Standard Better Auth core schema (https://better-auth.com); field names
// match exactly what its Prisma adapter expects, so don't rename these.
// Unrelated to the Employee model above, which is checkout attribution, not
// app access.
// ---------------------------------------------------------------------------

// Shared by Employee.role (kiosk PIN-reset authority) and User.role (desktop
// app permissions) — two separate concerns on two separate models, but the
// same three tiers, so one enum instead of duplicating it.
// Access level within the Inventory Audit module. Not a ladder — each level
// has its own capabilities (see src/lib/access.ts): AUDITOR is the inventory
// team (enters and uploads findings), MANAGER follows up on findings for
// their locations/departments, ADMIN does both and configures the module.
enum AuditRole {
  AUDITOR
  MANAGER
  ADMIN
}

enum StaffRole {
  USER
  MANAGER
  ADMIN
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Both wired into Better Auth's session via user.additionalFields in
  // src/lib/auth.ts (input: false — never settable by the account holder,
  // only by an admin via /users). isPurchasingTeam is the hard gate: false
  // means every desktop-app route redirects to /kiosk regardless of role.
  // role only matters once isPurchasingTeam is true.
  role             StaffRole  @default(USER)
  isPurchasingTeam Boolean    @default(false)
  // Access to the separate Inventory Audit module (/inventory-audit). Null =
  // no access. Independent of role/isPurchasingTeam above, which are this
  // user's access to the Consumable Management module. Also carried in the
  // session cookie so the proxy can gate /inventory-audit without a DB call.
  auditRole        AuditRole?

  sessions Session[]
  accounts Account[]
  // Reverse side of Employee.userId — null only for the shared,
  // location-signed-in kiosk tablet accounts, which are Users but not a
  // person.
  employee Employee?

  // Inventory Audit module (Ia* models below) — people on findings.
  iaFindingsAssigned  IaFinding[]      @relation("IaFindingAssignee")
  iaFindingsCreated   IaFinding[]      @relation("IaFindingCreator")
  iaFindingsResolved  IaFinding[]      @relation("IaFindingResolver")
  iaFindingsVerified  IaFinding[]      @relation("IaFindingVerifier")
  iaFindingEvents     IaFindingEvent[]
  iaCoverage          IaCoverage[]     @relation("IaCoverageUser")
  iaAuditsCreated     IaAudit[]        @relation("IaAuditCreator")
  iaAuditsCompleted   IaAudit[]        @relation("IaAuditCompleter")
  iaAuditLinesCounted IaAuditLine[]    @relation("IaAuditLineCounter")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// =============================================================================
// Inventory Audit module — completely separate from Consumable Management.
// Only User (logins/access) is shared. Everything here is prefixed `Ia` because
// the consumables side already has its own Audit / AuditStatus models.
// =============================================================================

enum IaAuditType {
  PRODUCT // system count vs physical count of product lines
  WASTE_LOG // waste log vs physical disposal
  PLANT // plant-room counts (mother, veg, flower, ...)
}

// Open -> Notified (department told) -> Resolved (dept manager confirms the
// fix) -> Verified (inventory team confirms). Reopening goes back to Open.
enum IaFindingStatus {
  OPEN
  NOTIFIED
  RESOLVED
  VERIFIED
}

// Where an audit happened. `aliases` are other spellings found in the old
// trackers ("McDowell - Hub"), so uploads match without hand-editing.
model IaFacility {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  findings IaFinding[]
  coverage IaCoverage[]
  audits   IaAudit[]
}

// The department a finding is attributed to (who has to fix it).
model IaDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  findings       IaFinding[]  @relation("IaFindingDept")
  findingsSecond IaFinding[]  @relation("IaFindingDept2")
  coverage       IaCoverage[]
  auditsDefault  IaAudit[]    @relation("IaAuditDefaultDept")
}

// e.g. "Internal Process", "AZDHS Compliance". defaultDueDays sets a finding's
// due date from its audit date (null = no automatic due date).
model IaFindingType {
  id             String   @id @default(cuid())
  name           String   @unique
  aliases        String[] @default([]) // e.g. "Compliance (AZDHS)" as written in the Key tab
  defaultDueDays Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  findings   IaFinding[]
  categories IaFindingCategory[]
}

// The standard kinds of finding from the tracker's Key tab ("Wrong room - Needs
// updating", "Unlabeled product", ...). Each one implies an impact level (the
// finding type: AZDHS Compliance or Internal Process), so picking a category
// pre-fills the type.
model IaFindingCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  findingType   IaFindingType @relation(fields: [findingTypeId], references: [id])
  findingTypeId String
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)

  findings IaFinding[]
}

model IaFinding {
  id        String      @id @default(cuid())
  auditType IaAuditType
  auditDate DateTime
  auditors  String? // initials as written on the tracker, e.g. "MS/TL/KW"

  facility           IaFacility         @relation(fields: [facilityId], references: [id])
  facilityId         String
  findingType        IaFindingType      @relation(fields: [findingTypeId], references: [id])
  findingTypeId      String
  category           IaFindingCategory? @relation(fields: [categoryId], references: [id])
  categoryId         String?
  department         IaDepartment       @relation("IaFindingDept", fields: [departmentId], references: [id])
  departmentId       String
  secondDepartment   IaDepartment?      @relation("IaFindingDept2", fields: [secondDepartmentId], references: [id])
  secondDepartmentId String?

  description String // the initial discrepancy finding

  // What was audited — which of these apply depends on auditType.
  product      String?
  batchId      String?
  pid          String?
  strain       String?
  quantity     Float?
  unit         String?
  room         String? // plant audits
  serialNo     String? // plant audits
  reference    String? // waste log reference # on the written log
  weightGrams  Float? // waste log
  disposalDate DateTime? // waste log

  correction      String?
  monitoringNotes String?

  status          IaFindingStatus @default(OPEN)
  dueDate         DateTime?
  notifiedAt      DateTime?
  resolvedAt      DateTime?
  verifiedAt      DateTime?
  resolutionNotes String?

  assignedTo   User?   @relation("IaFindingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  createdBy    User?   @relation("IaFindingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  resolvedBy   User?   @relation("IaFindingResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?
  verifiedBy   User?   @relation("IaFindingVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events IaFindingEvent[]

  // Set when the finding was documented while working through an audit.
  audit     IaAudit?     @relation(fields: [auditId], references: [id], onDelete: SetNull)
  auditId   String?
  auditLine IaAuditLine?

  @@index([auditId])
  @@index([status])
  @@index([facilityId])
  @@index([departmentId])
  @@index([dueDate])
  @@index([auditDate])
}

// The history of a finding: creation, status changes, notes, assignment.
model IaFindingEvent {
  id         String           @id @default(cuid())
  finding    IaFinding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId  String
  at         DateTime         @default(now())
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  kind       String // CREATED | STATUS | NOTE | ASSIGNED | EDITED
  fromStatus IaFindingStatus?
  toStatus   IaFindingStatus?
  note       String?

  @@index([findingId, at])
}

// Who follows up on which findings. A manager is routed a finding when it is
// assigned to them directly, or when it matches one of their coverage rows. A
// row names a facility, a department, or both (then both must match, e.g.
// "Fulfillment at McDowell Hub"); at least one is always set (enforced in the
// migration). Managers only see the findings routed to them.
model IaCoverage {
  id           String        @id @default(cuid())
  user         User          @relation("IaCoverageUser", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  facility     IaFacility?   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId   String?
  department   IaDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String?
  createdAt    DateTime      @default(now())

  @@index([userId])
}

// The wording of the findings email the app drafts for each manager. One row
// ("default"). The list of findings in the middle is generated; subject, intro
// and footer are editable and may use {managerName}, {count}, {date},
// {senderName} and {reportLink}.
model IaEmailTemplate {
  id        String   @id
  subject   String
  intro     String
  footer    String
  updatedAt DateTime @updatedAt
}

enum IaAuditStatus {
  IN_PROGRESS
  COMPLETED
}

enum IaLineStatus {
  PENDING // not counted yet
  OK // counted and matches (or counted with no system figure to compare)
  DISCREPANCY // counted differently, or flagged for a non-count problem; has a finding
}

// One inventory audit being worked through: the list of lines to audit is
// uploaded, then counted line by line, with discrepancies documented as
// findings while the audit is still open.
model IaAudit {
  id         String      @id @default(cuid())
  name       String
  auditType  IaAuditType
  auditDate  DateTime
  auditors   String? // initials / names of the team, as on the tracker
  notes      String?
  sourceFile String?

  facility            IaFacility    @relation(fields: [facilityId], references: [id])
  facilityId          String
  // Department new findings from this audit are attributed to unless changed.
  defaultDepartment   IaDepartment? @relation("IaAuditDefaultDept", fields: [defaultDepartmentId], references: [id])
  defaultDepartmentId String?

  status        IaAuditStatus @default(IN_PROGRESS)
  createdBy     User?         @relation("IaAuditCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?
  completedBy   User?         @relation("IaAuditCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedById String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    IaAuditLine[]
  findings IaFinding[]

  @@index([status])
  @@index([facilityId, auditDate])
}

model IaAuditLine {
  id       String  @id @default(cuid())
  audit    IaAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId  String
  position Int // order in the uploaded file

  product  String?
  batchId  String?
  pid      String?
  strain   String?
  room     String?
  serialNo String?
  unit     String?
  category String? // the product's own category (Edible Gummies, ...), not a finding category

  systemQty Float? // what the system says (from the upload)
  actualQty Float? // what was counted; null until counted

  status IaLineStatus @default(PENDING)
  note   String?

  countedBy   User?     @relation("IaAuditLineCounter", fields: [countedById], references: [id], onDelete: SetNull)
  countedById String?
  countedAt   DateTime?

  finding   IaFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  findingId String?    @unique

  // Also the version used to catch two people saving the same line at once.
  updatedAt DateTime @updatedAt

  @@index([auditId, status])
  @@index([auditId, room])
  @@index([auditId, position])
}
